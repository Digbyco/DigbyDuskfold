# Digby House website: Apache settings for OVHcloud web hosting.
# Upload this file together with the site. It changes nothing about email or DNS.

ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # STEP 2 OF THE UPLOAD INSTRUCTIONS: only once the SSL certificate shows as active in the
  # OVHcloud Control Panel, remove the "#" at the start of the next four lines, then re-upload
  # this file. Until then, leave them as they are, or the site will stop loading.
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://www.digbyhouse.co.uk%{REQUEST_URI} [L,R=301]
  # RewriteCond %{HTTP_HOST} ^digbyhouse\.co\.uk$ [NC]
  # RewriteRule ^ https://www.digbyhouse.co.uk%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>
